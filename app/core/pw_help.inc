/* SPDX-License-Identifier: GPL-3.0-only
 * The one-line description of each module (the add list's text, the help page's). tools/gen_examples.py packs these with the examples
 * into pw_examples_z.inc (read back by pw_type_help in pw_presets.c). Edit here. */
{PW_T_VCO, "Oscillator, 1V/oct, sync and PWM. DRIFT: pitch and pulse width wander. ANALOG: scope-style imperfect waves. FM MODE: EXP, LIN, TZ"},
{PW_T_LFO, "Low-frequency oscillator, 0.01-40 Hz; RATE bends its speed (1 V an octave), DEPTH its level (0-5 V). SYNC: a note value of the tempo"},
{PW_T_NOISE, "White, pink, brown and digital noise; TONE darkens or thins them. DUST: random clicks, DENSITY a second (DTRIG: a gate each)"},
{PW_T_WAVETABLE, "Digital wavetable oscillator, 4 banks x 8 frames"},
{PW_T_COMPLEX, "West-coast dual oscillator: FM pair into a wavefolder"},
{PW_T_VCF, "Six circuits (TYPE): state-variable, transistor ladder, diode ladder, OTA 4-pole and 2-pole, Sallen-Key. KEY (a pitch) moves the cutoff by KEYTRK"},
{PW_T_VCA, "Amplifier. CV patched: GAIN sets the maximum"},
{PW_T_FOLDER, "Wavefolder: SHAPE FOLD (triangle), SINE, CHEBY (a Chebyshev waveshaper: ORDER) or 259 (after the Buchla 259: five folding stages, TONE its output low pass)"},
{PW_T_HARMTREM, "Harmonic tremolo: lows and highs swell in turn (its own LFO; SPLIT is where they part), so the tone swirls instead of pulsing. SYNC: a note value of the tempo"},
{PW_T_DIST, "Saturation, clipping, fuzz and bitcrush"},
{PW_T_DELAY, "Echo with filtered, saturating feedback. SYNC to the tempo, TAP, PING-PONG (L, R), WOBBLE like tape, FREEZE"},
{PW_T_REVERB, "Stereo reverb: ROOM, HALL, PLATE, GATED or SWELL. FREEZE holds the tail forever, SHIMMER lets it climb in pitch"},
{PW_T_RING, "Ring modulator and frequency shifter"},
{PW_T_ENV, "ADSR / AD / AR envelope. LOOP cycles it, CURVE bends a stage, TRIGGER: soft, hard, legato, VEL scales it, RANGE x0.1 or x10"},
{PW_T_FUNC, "Rise/fall function generator and slew limiter"},
{PW_T_SH, "Sample & hold, smooth random and random gates. SYNC: RATE as a note value of the tempo"},
{PW_T_ATTEN, "Two attenuverters with offset; CURVE bends, RECT flips or cuts the negative half"},
{PW_T_CVMIX, "Four bipolar CV inputs plus offset"},
{PW_T_LOGIC, "Gate logic, comparator, MIN, MAX and ABS"},
{PW_T_COMPARE, "Compares A with B (or a level) and gates when A is over, under, near, or has crossed it. HYST stops chatter, PULSE makes triggers"},
{PW_T_SWITCH, "Sequential switch 4>1 and 1>4"},
{PW_T_SEQ, "16 steps of pitch and gate with ratchet, chance and velocity, and TIE or GLIDE on a step for 303 slides. Swing, divide, length by CV. Sounds keys as you record"},
{PW_T_MODSEQ, "Four lanes of 16 steps of voltage to patch anywhere. Each lane has its own length, so they drift against each other; slew, range, chance, direction"},
{PW_T_CHORDSTEPS, "A chord progression in a key: each step a degree, a rest or a tie, with a type and an inversion. Four pitches, a gate and a bass note out"},
{PW_T_GRAVITY, "A bouncing ball plays a tune: each bounce is the next note, faster and softer until it settles. Drops every few beats, or on a trigger"},
{PW_T_LISTENER, "Plays a melody from a sound: each onset (a drum hit, a clap, a word) becomes a note chosen from how bright it is, how loud, or its pitch, in a scale"},
{PW_T_CLOCK, "Tempo, divided, multiplied, swung. WARP bends time: COUNT pulses over LENGTH steps, rushing or dragging"},
{PW_T_QUANT, "Pitch quantizer with 12 scales"},
{PW_T_LPG, "Vactrol low-pass gate: strike it with PING, or open it with CV. Tails ring longer the harder it is played (MEMORY)"},
{PW_T_SAMPLER, "Plays a bank sound or its own recording (not saved): classic, one-shot, sliced, looped, reversed, stretched; BEATS fits it to the tempo"},
{PW_T_OUTPUT, "Main stereo output to the headphones and USB; R follows L when unpatched. LEVEL sets the volume; PROTECT is a limiter that stops clipping"},
{PW_T_BUTTON, "Turn keys into patchable controls: gate, trigger, toggle, repeat, burst, tap, sample. All 27 keys; no KEYS needed. GLO+HOME: notes or buttons"},
{PW_T_KEYS, "Keys and MIDI notes (USB or TRS; bend, mod wheel, sustain pedal): pitch, gate, velocity (how hard a key lands), pressure (leaning into it)"},
{PW_T_SWIRL, "A FLANGER, PHASER or CHORUS (TYPE): a swept delay or filter. FBK, DELAY: flanger; FREQ: phaser; WIDTH: chorus. SYNC: RATE as a note value"},
{PW_T_FM4, "Two-operator FM voice: RATIO and INDEX set the tone, AMP and MOD pick the envelope shapes (pluck, bell, pad...); PRESET: a sound to start from"},
{PW_T_LOOPER, "Phrase looper: REC layers input over BEATS (1/8 up) at the tempo; FBK fades old layers, TONE darkens them; REC off holds the loop"},
{PW_T_DRUMS, "A synthesized drum: swept oscillator, FM, filtered noise, drive; METAL: squares for cymbals, BURST: clap re-strikes; PRESET: 48 starting sounds"},
{PW_T_ENVFOLLOW, "Turns a sound's loudness into a voltage: ENV follows it, INV is the opposite (to duck another sound), GATE is high above THRESH"},
{PW_T_FRACTURE, "Breaks up the sound: GLITCH stutters, REVERSE plays it backwards, SHUFFLE reorders recent beats. SYNC: TIME as a note value"},
{PW_T_AUDIOIN, "The computer's sound over USB (the 3.5 mm jack is MIDI only). Into a SAMPLER IN with a gate in REC it records. Emulator: microphone or tab"},
{PW_T_EUCLID, "Euclidean rhythms: HITS spread evenly over STEPS. Unpatched clock follows PLAY"},
{PW_T_STRING, "Struck things that ring: drum heads, bells, wood blocks, metal sheets, springs, pipes, gongs, strings. PRESET sets the material; TRIG strikes it"},
{PW_T_VOWEL, "Formant filter: talking A E I O U"},
{PW_T_COMP, "Evens out levels; patch SIDE to duck under another sound. MIX < 100%: parallel compression"},
{PW_T_ARP, "Plays the held keys one by one; unpatched clock: RATE of the tempo"},
{PW_T_TURING, "A looping random sequence that slowly changes (CHANCE), 2-32 steps long. LOCK (or a gate into it) holds the loop. Unpatched clock follows PLAY"},
{PW_T_STEREO, "Four channels with level and pan (centred: the same in L and R, so L alone is a mono mixer), soft limited"},
{PW_T_CHAOS, "The Lorenz attractor: three tangled, wandering voltages"},
{PW_T_COIN, "Each trigger goes on to A, or by CHANCE to B instead (a coin toss: Bernoulli gate)"},
{PW_T_CHORD, "One pitch in, a chord of four out: one VCO each"},
{PW_T_FORMANT, "A voice-like oscillator: grains at the vowel's formants, one per period (G2)"},
{PW_T_COMB, "Resonant peaks at FREQ's harmonics: metallic, plucked, flanged (G2)"},
{PW_T_EQ, "Three-band EQ: low shelf, sweepable mid bell, high shelf (G2)"},
{PW_T_WAVESET, "Reshuffles a note's cycles in ten ways: repeat, reverse, omit, divide, freeze, scramble, average, telescope... AMOUNT: how much"},
{PW_T_MUTATE, "A pulse on NUDGE or ROLL shakes the patch: knobs and steps drift or jump. AMOUNT: how far (CV), DENSITY: how many"},
{PW_T_VOCODER, "MOD (a voice, drums) shapes CARRIER in 12 bands. Nothing on MOD: bands follow their neighbours. SHIFT slides them, FOCUS narrows, BRIGHT tilts up"},
{PW_T_PSHIFT, "Moves the sound up or down by SHIFT semitones, keeping its length (G2)"},
{PW_T_TRIGSEQ, "Drum grid: 4 tracks x 16 steps (on, accent, roll), polymeter, chance, swing, fills; CHANCE, SHIFT, SWING by CV"},
{PW_T_DRUMRACK, "Eight pads: drawn drums or bank samples; KIT sets all eight (808, 909, the bank...); T1-T8, ACC or the keys strike them"},
{PW_T_MIDIIN, "Four MIDI CCs as voltages (a controller's knobs), the transport's clock and run; notes come in through KEYS"},
{PW_T_MIDIOUT, "Plays other gear over USB: notes from PITCH and GATE, two CCs, and MIDI clock with the transport"},
{PW_T_CVREC, "Records a voltage or its KNOB over LENGTH beats and loops it in time: one pass or overdubs, half or double speed, backwards"},
{PW_T_GRAIN, "A cloud of short grains from what comes in (or a bank sound): position, size, density, pitch, scatter, stereo, freeze"},
{PW_T_TAPE, "A tape machine: saturation, wow and flutter, age, hiss; STOP brakes it; SPEED is varispeed (CV: 1 V an octave)"},
{PW_T_SCOPE, "Draws A and B (unpatched: the output under the patch cursor). MODE SPECTRUM draws the frequencies instead"},
{PW_T_GATEDLY, "Two gates or triggers, each later by its TIME (2 s) or a SYNC note value; lengths kept; CV adds +-1 s. B unpatched: a second tap of A"},
{PW_T_ADDITIVE, "32 sine partials shaped by SHAPE, BRIGHT, a resonant PEAK, sweeping COMB notches and STRETCH (bells); GATE plucks it brighter"},
{PW_T_MACRO, "Eight oscillators in one (VA, FOLD, FM, FORMANT, CHORD, SWARM, NOISE, PARTICLE), each with HARM, TIMBRE, MORPH; TRIG strikes its own low pass gate"},
{PW_T_MICROPERC, "Clicks, zaps, blips, ticks, metal and crackle; SCATTER makes every hit a little different"},
{PW_T_LIMITER, "Nothing passes CEILING. DRIVE pushes into it; BRICK holds, SOFT rounds, FOLD folds back. PUMP ducks on every beat"},
{PW_T_OTT, "Three-band compression both ways: loud down, quiet up, until it all sounds big and close. DEPTH is how much"},
{PW_T_MARKOV, "A melody from chances: each step picks a near note (STEP), pulled home (HOME), with REPEAT and REST. LEARN studies a tune"},
{PW_T_XFADE, "Crossfade: MIX blends A into B, by knob and CV (0-5 V is the whole way). EQUAL POWER keeps the loudness, LINEAR suits CV"},
{PW_T_SNAPSHOT, "A CV picks the snapshot (0-5 V over SCENES); a clock makes it read on ticks. Noise: random, LFO: drift, MOD SEQ: a plan"},
{PW_T_INERTIA, "Momentum and spring-like motion for CV. FOLLOW: the CV is a target. PUSH: a force. FLICK: its changes kick it. MIX: dry CV in"},
{PW_T_BURST, "One trigger makes a rapid series of triggers that speed up or slow down. CURVE bends the speed; LEVEL falls, PITCH steps. SYNC: a note value"},
{PW_T_SPACE, "A small, cheap stereo reverb to use freely: SIZE sets the room and its tail together, TONE darkens it"},
{PW_T_ROOM, "A room's standing waves: resonances that are not harmonics, set ringing by what comes in. ROOT is the longest wall"},
{PW_T_GENDY, "Xenakis' stochastic wave: POINTS corners that wander at random every cycle. CHAOS sets how far, DIST the odds; RANGE makes it audio or CV"},
{PW_T_CZ, "Casio CZ voice: BANK and PRESET pick a tone; the knobs show it, and moving one changes it (*). DCW in bends it"},
{PW_T_SHIFTREG, "A CV shift register: each CLOCK shifts the stored values along. NOW, -1, -2, -3 and END tap them (canons, delays); FEEDBK recirculates"},
{PW_T_PARAMMOD, "A voltage moves any knob of any module: pick the MODULE and its PARAM, patch CV 1-4. DEPTH is how far 5 V moves it, read 2.7 thousand times a second"},
{PW_T_MIX8, "Eight channels with level and pan (like MIXER, but eight), soft limited"},
{PW_T_FMDX, "Four-operator FM voice on the TX81Z chip: BANK and PRESET pick a voice, the knobs show it and moving one changes it (*). INDEX and FM bend it"},
{PW_T_PROLL, "Piano roll: notes on a grid, chords of up to four voices on one PITCH, GATE and VEL cable. BARS 1-4 loops. Edit on the SEQ page"},
